rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validAlert(d) {
      return d.keys().hasOnly(['keyword', 'maxPrice', 'excludeWords', 'shops', 'categories', 'enabled', 'createdAt', 'updatedAt'])
        && d.keyword is string && d.keyword.size() > 0 && d.keyword.size() <= 40
        && (d.maxPrice == null || d.maxPrice is int)
        && d.excludeWords is list && d.excludeWords.size() <= 10
        && d.shops is list && d.shops.size() <= 10
        && d.categories is list && d.categories.size() <= 7
        && d.enabled is bool;
    }

    // Deals and product price histories are written only by the crawler (Admin SDK bypasses rules).
    match /deals/{dealId} {
      allow read: if true;
      allow write: if false;
    }
    match /products/{key} {
      allow read: if true;
      allow write: if false;
    }

    function validFavorite(d) {
      return d.keys().hasOnly(['dealId', 'title', 'productName', 'shop', 'price', 'currency', 'thumbnail', 'url',
                               'sourceName', 'groupKey', 'productKey', 'postedAt', 'savedAt'])
        && d.dealId is string && d.url is string && d.url.size() <= 500
        && d.productName is string && d.productName.size() <= 300;
    }

    function validTracked(d, key) {
      return d.keys().hasOnly(['key', 'name', 'targetPrice', 'createdAt', 'updatedAt'])
        && d.key == key && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && (d.targetPrice == null || (d.targetPrice is int && d.targetPrice > 0));
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && (!('fcmTokens' in request.resource.data) || request.resource.data.fcmTokens.size() <= 10);

      match /alerts/{alertId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validAlert(request.resource.data);
      }

      // 찜한 딜 (a snapshot of the deal when saved).
      match /favorites/{dealId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validFavorite(request.resource.data) && request.resource.data.dealId == dealId;
      }

      // 추적 상품: products/{key} the user follows, with an optional target price.
      match /tracked/{key} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTracked(request.resource.data, key);
      }

      // Alert history, written by the crawler.
      match /sent/{sentId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }
    }
  }
}
