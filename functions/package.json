{
  "name": "openrun-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "test": "deno test -A --sloppy-imports test/",
    "crawl:dry": "deno run -A --sloppy-imports scripts/dump_deals.ts",
    "fixture": "deno run -A --sloppy-imports scripts/make_fixture.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
